# SparsePath artifact — host-side environment (copy to .env next to docker-compose.yml)
# docker compose reads .env automatically; the launcher scripts read the DANNS_* vars.

# --- Host directories (orchestrator) -----------------------------------------
DATASETS_ROOT=/srv/sparsepath/datasets      # holds vldb/deep300M/deep300M_{base,query}.fbin  (Phase B-1)
EXPERIMENTS_ROOT=./experiments              # artifacts/ + results/ + configs/; must be visible to every worker
                                            #   (shared NFS is the tested layout; rsync also works)
RAW_DIR=/srv/sparsepath/raw                 # raw 1B downloads (data/download_and_extract.sh)

# --- Worker hosts ------------------------------------------------------------
WORKER_LOCAL_SSD=/data/sparsepath/colocation   # mounted at /workspace/colocation_local (colocation.local_dir)
RDMA_DEVICE=mlx5_0                          # ibv_devinfo on the worker host
RDMA_GID_INDEX=3                            # RoCEv2/IPv4 is usually 3 (show_gids)

# --- Container user mapping --------------------------------------------------
HOST_UID=1000
HOST_GID=1000
USERNAME=sparsepath

# --- Remote exec helper (danns-exec.sh) --------------------------------------
REMOTE_ARTIFACT_ROOT=/srv/sparsepath/artifact   # same path on every host

# --- Build flags (build_all.sh) ----------------------------------------------
# Common ISA upper bound of ALL hosts that load lib/*.so. Never use "native"
# when build host and workers differ (SIGILL). Empty = legacy -mavx2 -mfma.
DANNS_ARCH=icelake-server
DANNS_FAST_MATH=ON
